# SupportOps API (temporary shared Nexus database; see README before deployment)
NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ISSUER=nexus-api
JWT_AUDIENCE=nexus-client
FRONTEND_URL=https://supportops.nexusthecore.com
IDENTITY_FRONTEND_URL=https://nexusthecore.com
APP_URL=https://supportops.nexusthecore.com
CORS_ALLOWED_ORIGINS=https://supportops.nexusthecore.com
PUBLIC_API_URL=https://supportops-ai.onrender.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REDIS_URL=
# Generate once with: openssl rand -base64 32
# Keep this value stable; rotating it without re-encrypting channel rows breaks integrations.
CHANNELS_ENC_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
POSTMARK_TOKEN=
INVITE_FROM=

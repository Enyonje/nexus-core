// Copy to src/agents/plugins/<your-slug>.js (or run: npm run agent:new -- <your-slug> "Your Agent").
import { defineAgent } from "../defineAgent.js";

export default defineAgent({
  slug: "your-slug",
  name: "Your Agent",
  agentType: "WORKER",
  product: "nexus-core",
  capabilities: {},
  async run({ input, user, log }) {
    log.info({ user: user.id }, "your-slug ran");
    return { echo: input };
  },
});

{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "rootDir": "./",
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "ignoreDeprecations": "6.0",
        "baseUrl": "./",
        "paths": {
            "@shared/*": [
                "src/shared/*",
                "shared/*"
            ],
            "@src/*": [
                "src/*"
            ]
        }
    },
    "include": [
        "src/**/*",
        "gateway/**/*",
        "orchestrator/**/*",
        "services/**/*",
        "shared/**/*",
        "*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
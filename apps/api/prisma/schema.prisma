generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  user
  admin
}

enum SubscriptionType {
  free
  pro
  enterprise
}

enum ExecutionStatus {
  pending
  running
  completed
  failed
}

enum GoalStatus {
  active
  archived
  completed
}

enum PipelineStage {
  IDLE
  PARSING
  AUDITING
  CALCULATING
  READY_FOR_PAYMENT
  COMPLETED
  FAILED
}

enum DiscrepancySeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

enum OrgType {
  PERSONAL
  TEAM
}

enum OrgRole {
  owner
  admin
  member
  billing
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  incomplete
}

enum PlanAudience {
  INDIVIDUAL
  TEAM
  BOTH
}

enum BillingModel {
  FLAT
  PER_SEAT
}

enum InviteStatus {
  pending
  accepted
  revoked
  expired
}

// ============================================================
// MODELS
// ============================================================

model User {
  id                    String            @id @default(uuid())
  email                 String            @unique
  password_hash         String
  created_at            DateTime          @default(now())
  org_id                String?
  role                  UserRole          @default(user)
  subscription          SubscriptionType  @default(free)
  name                  String?
  refresh_token         String?
  failed_attempts       Int               @default(0)
  locked_until          DateTime?         @db.Timestamptz(6)
  mfa_enabled           Boolean           @default(false)
  mfa_secret            String?
  reset_token           String?
  reset_token_expires   DateTime?         @db.Timestamptz(6)
  refresh_token_expires DateTime?         @db.Timestamptz(6)
  deleted_at            DateTime?
  ai_used               Int               @default(0)
  executions_count      Int               @default(0)
  is_platform_admin     Boolean           @default(false)

  // Relations
  authAudits      AuthAudit[]
  executionSteps  ExecutionStep[]
  executions      Execution[]
  goals           Goal[]
  adminAudits     AdminAudit[]
  organization    Organization?     @relation(fields: [org_id], references: [id])
  memberships     Membership[]
  appAccess       AppAccess[]
  sessions        Session[]

  @@map("users")
  @@index([org_id])
  @@index([created_at])
}

model Organization {
  id                 String         @id @default(uuid())
  name               String
  type               OrgType        @default(TEAM)
  owner_id           String?
  stripe_customer_id String?        @unique
  created_at         DateTime       @default(now())
  deleted_at         DateTime?

  // Relations
  users         User[]
  subscriptions Subscription[]
  memberships   Membership[]
  appAccess     AppAccess[]
  invites       Invite[]
  usage         UsageRecord[]

  @@map("organizations")
  @@index([owner_id])
}

model Goal {
  id           String      @id @default(uuid())
  user_id      String
  title        String
  description  String?
  status       GoalStatus  @default(active)
  created_at   DateTime    @default(now())
  goal_type    String?
  goal_payload Json?
  org_id       String?
  deleted_at   DateTime?

  // Relations
  executions Execution[]
  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  objectives Objective[]

  @@map("goals")
  @@index([user_id])
  @@index([org_id])
  @@index([created_at])
}

model Objective {
  id           String      @id @default(uuid())
  goal_id      String
  title        String
  description  String?
  completed    Boolean     @default(false)
  created_at   DateTime    @default(now())
  goal_payload Json?
  deleted_at   DateTime?

  // Relations
  executions Execution[]
  goal       Goal        @relation(fields: [goal_id], references: [id], onDelete: Cascade)

  @@map("objectives")
  @@index([goal_id])
  @@index([created_at])
}

model Execution {
  id           String          @id @default(uuid())
  user_id      String
  goal_id      String
  objective_id String?
  action       String?
  details      Json?
  created_at   DateTime        @default(now())
  started_at   DateTime?
  goal_type    String?
  org_id       String?
  version      Int?
  status       ExecutionStatus @default(pending)
  schedule     Json?
  recurring    Boolean?        @default(false)
  duration_ms  Int?
  finished_at  DateTime?
  goal_payload Json            @default("{}")
  result       Json?
  error        String?
  deleted_at   DateTime?

  // Relations
  executionAudits ExecutionAudit[]
  executionSteps  ExecutionStep[]
  user            User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  goal            Goal             @relation(fields: [goal_id], references: [id])
  objective       Objective?       @relation(fields: [objective_id], references: [id], onDelete: Restrict)

  @@map("executions")
  @@index([user_id])
  @@index([goal_id])
  @@index([org_id])
  @@index([created_at])
  @@index([status])
  @@unique([goal_id, user_id, created_at])
}

model AuthAudit {
  id         String   @id @default(uuid())
  user_id    String
  action     String
  details    Json?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("audit")
  @@index([user_id])
  @@index([created_at])
}

model ExecutionAudit {
  id           String    @id @default(uuid())
  execution_id String
  status       String?
  meta         Json?
  created_at   DateTime  @default(now())
  event        String    @default("unknown")
  execution    Execution @relation(fields: [execution_id], references: [id], onDelete: Cascade)

  @@map("execution_audit")
  @@index([execution_id])
  @@index([created_at])
}

model App {
  id           String   @id @default(uuid())
  slug         String   @unique // "supportops", "compliance"
  name         String
  roles        String[] // roles this app understands
  default_role String   // role given to a new owner
  active       Boolean  @default(true)
  created_at   DateTime @default(now())

  // Relations
  plans         Plan[]
  addons        Addon[]
  subscriptions Subscription[]
  appAccess     AppAccess[]
  invites       Invite[]
  usage         UsageRecord[]

  @@map("apps")
}

model Plan {
  id              String       @id @default(uuid())
  app_id          String
  key             String       // "free" | "pro" | "enterprise"
  name            String
  audience        PlanAudience @default(BOTH)
  billing_model   BillingModel @default(FLAT)
  features        String[]     // "ai_review", "revenue_forecast", ...
  limits          Json         @default("{}") // { "seats": 5, "ai_calls": 1000 }
  price_cents     Int?
  currency        String       @default("usd")
  stripe_price_id String?      @unique
  active          Boolean      @default(true)

  // Relations
  app           App            @relation(fields: [app_id], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([app_id, key])
  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid())
  org_id                 String
  app_id                 String
  plan_id                String
  status                 SubscriptionStatus @default(active)
  quantity               Int                @default(1) // seats billed (PER_SEAT plans)
  current_period_end     DateTime?
  trial_ends_at          DateTime?
  cancel_at_period_end   Boolean            @default(false)
  limit_overrides        Json?              // trial caps, e.g. { "ai_resolutions": 100 }
  stripe_subscription_id String?            @unique
  created_at             DateTime           @default(now())
  updated_at             DateTime           @updatedAt

  // Relations
  org    Organization        @relation(fields: [org_id], references: [id], onDelete: Cascade)
  app    App                 @relation(fields: [app_id], references: [id])
  plan   Plan                @relation(fields: [plan_id], references: [id])
  addons SubscriptionAddon[]

  @@unique([org_id, app_id])
  @@index([status])
  @@map("subscriptions")
}

model Membership {
  org_id     String
  user_id    String
  org_role   OrgRole  @default(member)
  created_at DateTime @default(now())

  org  Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([org_id, user_id])
  @@index([user_id])
  @@map("memberships")
}

model AppAccess {
  org_id     String
  user_id    String
  app_id     String
  app_role   String   // validated against App.roles
  created_at DateTime @default(now())

  org  Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  app  App          @relation(fields: [app_id], references: [id], onDelete: Cascade)

  @@id([org_id, user_id, app_id])
  @@index([user_id])
  @@map("app_access")
}

model Invite {
  id         String       @id @default(uuid())
  org_id     String
  email      String
  org_role   OrgRole      @default(member)
  app_id     String?
  app_role   String?
  token_hash String       @unique
  status     InviteStatus @default(pending)
  invited_by String
  expires_at DateTime
  created_at DateTime     @default(now())

  org Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  app App?         @relation(fields: [app_id], references: [id])

  @@index([email])
  @@map("invites")
}

model UsageRecord {
  id     String @id @default(uuid())
  org_id String
  app_id String
  metric String
  period String
  count  Int    @default(0)

  org Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  app App          @relation(fields: [app_id], references: [id], onDelete: Cascade)

  @@unique([org_id, app_id, metric, period])
  @@map("usage_records")
}

model StripeEvent {
  id           String   @id // Stripe's event id
  type         String
  processed_at DateTime @default(now())

  @@map("stripe_events")
}

model Addon {
  id              String   @id @default(uuid())
  app_id          String
  key             String
  name            String
  features        String[]
  price_cents     Int?
  stripe_price_id String?  @unique

  app           App                 @relation(fields: [app_id], references: [id], onDelete: Cascade)
  subscriptions SubscriptionAddon[]

  @@unique([app_id, key])
  @@map("addons")
}

model SubscriptionAddon {
  subscription_id String
  addon_id        String
  created_at      DateTime @default(now())

  subscription Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)
  addon        Addon        @relation(fields: [addon_id], references: [id], onDelete: Cascade)

  @@id([subscription_id, addon_id])
  @@map("subscription_addons")
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  familyId  String    // detects refresh-token reuse
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExecutionStep {
  id           String    @id @default(uuid())
  execution_id String
  user_id      String
  org_id       String?
  name         String
  reasoning    String?
  step_type    String?
  created_at   DateTime  @default(now())
  status       String
  started_at   DateTime  @default(now())
  finished_at  DateTime?
  output       Json?
  error        String?
  deleted_at   DateTime?

  execution Execution @relation(fields: [execution_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("execution_steps")
  @@index([execution_id])
  @@index([user_id])
  @@index([created_at])
}

model AdminAudit {
  id        String   @id @default(uuid())
  admin_id  String
  action    String
  target_id String?
  meta      Json?
  created_at DateTime @default(now())

  admin User @relation(fields: [admin_id], references: [id], onDelete: Cascade)
}

model CargoDeclaration {
  id              String        @id @default(uuid())
  importerName    String
  importerTaxId   String        // e.g. KRA PIN "KE-0519283741"
  exporterName    String
  originCountry   String        @default("UG")
  portOfDischarge String        @default("Nairobi ICD")
  incoterm        String        @default("CIF")
  grossWeightKg   Float
  totalUnits      Int
  cifValueUsd     Float
  exchangeRateKe  Float         @default(130.0)

  pipelineStage PipelineStage @default(IDLE)

  // Relations
  items      CargoItem[]
  auditFlags AuditFlag[]
  assessment DutyAssessment?
  payment    MpesaTransaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CargoItem {
  id                 String           @id @default(uuid())
  cargoDeclarationId String
  cargoDeclaration   CargoDeclaration @relation(fields: [cargoDeclarationId], references: [id], onDelete: Cascade)

  description  String
  hsCode       String
  totalPriceUsd Float
  cetRate      Float // Tariff rate (e.g. 0.25 for 25%)

  createdAt DateTime @default(now())
}

model AuditFlag {
  id                 String              @id @default(uuid())
  cargoDeclarationId String
  cargoDeclaration   CargoDeclaration    @relation(fields: [cargoDeclarationId], references: [id], onDelete: Cascade)

  severity DiscrepancySeverity @default(WARNING)
  field    String              // e.g. "grossWeightKg"
  message  String

  createdAt DateTime @default(now())
}

model DutyAssessment {
  id                 String           @id @default(uuid())
  cargoDeclarationId String           @unique
  cargoDeclaration   CargoDeclaration @relation(fields: [cargoDeclarationId], references: [id], onDelete: Cascade)

  cifValueUsd        Float
  cifValueKes        Float
  importDutyKes      Float
  idfKes             Float
  rdlKes             Float
  vatKes             Float
  totalCustomsTaxKes Float

  // Generated iCMS IM4 Declaration payload string
  generatedXml String? @db.Text

  createdAt DateTime @default(now())
}

model MpesaTransaction {
  id                 String           @id @default(uuid())
  cargoDeclarationId String           @unique
  cargoDeclaration   CargoDeclaration @relation(fields: [cargoDeclarationId], references: [id], onDelete: Cascade)

  phoneNumber      String // Format: 2547XXXXXXXX
  amount           Float
  accountReference String @default("KRA-DUTY-DECL")

  // Daraja STK Push Tracker Keys
  checkoutRequestId  String? @unique
  merchantRequestId  String?
  mpesaReceiptNumber String? @unique

  status     PaymentStatus @default(PENDING)
  resultDesc String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
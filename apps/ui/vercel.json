{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nexus-core-a0px.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(executions|goals|admin|subscription|billing|dashboard|login|register|forgot-password|reset-password)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/compliance/(login|register|forgot-password|reset-password|billing)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/supportops/(login|agent|admin|management|investor)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/agent",
      "destination": "/agents",
      "permanent": true
    },
    {
      "source": "/agent/:slug*",
      "destination": "/agents/:slug*",
      "permanent": true
    }
  ]
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS
enum UserRole {
  user
  admin
}

enum SubscriptionType {
  free
  pro
  enterprise
}

enum ExecutionStatus {
  pending
  running
  completed
  failed
}

enum GoalStatus {
  active
  archived
  completed
}

// MODELS
model User {
  id                  String          @id @default(uuid())
  email               String          @unique
  password_hash       String
  created_at          DateTime        @default(now())
  org_id              String?
  role                UserRole        @default(user)
  subscription        SubscriptionType @default(free)
  name                String?
  refresh_token       String?
  failed_attempts     Int             @default(0)
  locked_until        DateTime?       @db.Timestamptz(6)
  mfa_enabled         Boolean         @default(false)
  mfa_secret          String?
  reset_token         String?
  reset_token_expires DateTime?       @db.Timestamptz(6)
  refresh_token_expires DateTime? @db.Timestamptz(6)
  deleted_at          DateTime?
  ai_used             Int             @default(0)
  executions_count      Int             @default(0)

  // Relations
  authAudits          AuthAudit[]
  executionSteps      ExecutionStep[]
  executions          Execution[]
  goals               Goal[]
  adminAudits         AdminAudit[]
  organization        Organization?   @relation(fields: [org_id], references: [id])

  @@map("users")
  @@index([org_id])
  @@index([created_at])
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now())
  users      User[]
  deleted_at DateTime?

  @@map("organizations")
}

model Goal {
  id           String      @id @default(uuid())
  user_id      String
  title        String
  description  String?
  status       GoalStatus  @default(active)
  created_at   DateTime    @default(now())
  goal_type    String?
  goal_payload Json?
  org_id       String?
  executions   Execution[]
  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  objectives   Objective[]
  deleted_at   DateTime?

  @@map("goals")
  @@index([user_id])
  @@index([org_id])
  @@index([created_at])
}

model Objective {
  id           String      @id @default(uuid())
  goal_id      String
  title        String
  description  String?
  completed    Boolean     @default(false)
  created_at   DateTime    @default(now())
  goal_payload Json?
  executions   Execution[]
  goal         Goal        @relation(fields: [goal_id], references: [id], onDelete: Cascade)
  deleted_at   DateTime?

  @@map("objectives")
  @@index([goal_id])
  @@index([created_at])
}

model Execution {
  id              String          @id @default(uuid())
  user_id         String
  goal_id         String
  objective_id    String?
  action          String?
  details         Json?
  created_at      DateTime        @default(now())
  started_at      DateTime?
  goal_type       String?
  org_id          String?
  version         Int?
  status          ExecutionStatus @default(pending)
  schedule        Json?
  recurring       Boolean?        @default(false)
  duration_ms     Int?
  finished_at     DateTime?
  goal_payload    Json            @default("{}")
  result          Json?
  error           String?
  deleted_at      DateTime?

  // Relations
  executionAudits ExecutionAudit[]
  executionSteps  ExecutionStep[]
  user            User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  goal            Goal       @relation(fields: [goal_id], references: [id])
  objective       Objective? @relation(fields: [objective_id], references: [id], onDelete: Restrict)

  @@map("executions")
  @@index([user_id])
  @@index([goal_id])
  @@index([org_id])
  @@index([created_at])
  @@index([status])
  @@unique([goal_id, user_id, created_at])
}


model AuthAudit {
  id         String   @id @default(uuid())
  user_id    String
  action     String
  details    Json?
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("audit")
  @@index([user_id])
  @@index([created_at])
}

model ExecutionAudit {
  id           String    @id @default(uuid())
  execution_id String
  status       String?
  meta         Json?
  created_at   DateTime  @default(now())
  event        String    @default("unknown")
  execution    Execution @relation(fields: [execution_id], references: [id], onDelete: Cascade)

  @@map("execution_audit")
  @@index([execution_id])
  @@index([created_at])
}

model ExecutionStep {
  id           String    @id @default(uuid())
  execution_id String
  user_id      String
  org_id       String?
  name         String
  reasoning    String?
  step_type    String?
  created_at   DateTime  @default(now())
  status       String
  started_at   DateTime  @default(now())
  finished_at  DateTime?
  output       Json?
  error        String?
  deleted_at   DateTime?

  execution    Execution @relation(fields: [execution_id], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("execution_steps")
  @@index([execution_id])
  @@index([user_id])
  @@index([created_at])
}

model AdminAudit {
  id         String   @id @default(uuid())
  admin_id   String
  action     String
  target_id  String?
  meta       Json?
  created_at DateTime @default(now())

  admin User @relation(fields: [admin_id], references: [id], onDelete: Cascade)
}

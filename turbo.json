{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [
        ".env",
        ".env.local"
    ],
    "globalEnv": [
        "NODE_ENV",
        "DATABASE_URL",
        "NEXT_PUBLIC_API_URL",
        "SUPPORT_ENGINE_URL",
        "COMPLIANCE_ENGINE_URL"
    ],
    "pipeline": {
        "db:generate": {
            "inputs": [
                "prisma/schema.prisma"
            ],
            "outputs": [
                "node_modules/.prisma/client/**"
            ]
        },
        "db:push": {
            "inputs": [
                "prisma/schema.prisma"
            ],
            "cache": false
        },
        "build": {
            "dependsOn": [
                "^build",
                "db:generate"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**",
                "build/**"
            ]
        },
        "dev": {
            "dependsOn": [
                "db:generate"
            ],
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": [
                "^build"
            ]
        },
        "clean": {
            "cache": false
        }
    }
}